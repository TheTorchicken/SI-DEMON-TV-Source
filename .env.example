# Local dashboard and relay. To serve on your own LAN, set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8787
CAST_PORT=8790
# Give the hosted car receiver a different name from local browser tests.
CAST_NAME=SI-DEMON-TV (Mac)
# The relay generates and persists a random key in .data/token unless supplied.
# DEMON_TOKEN=your-own-long-random-key
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the exact origin of your hosted dashboard above (no trailing path).
# For a separately hosted dashboard, set VITE_RELAY_URL before npm run build.
# VITE_RELAY_URL=https://relay.example.com
# Optional yt-dlp cookie file for videos requiring your own account. Never commit it.
# YTDLP_COOKIES=/absolute/path/to/private/cookies.txt
# YTDLP_PATH=/absolute/path/to/yt-dlp
# FFMPEG_PATH=/absolute/path/to/ffmpeg
